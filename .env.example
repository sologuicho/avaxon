# Promocionar publicaciones (Meta Marketing API) -- solo nombres, nunca
# valores reales. Ver docs/promociones-meta.md.
#
# Reutiliza, si la app de Meta es la misma que ya usa el módulo de
# Publicaciones en redes:
#   META_APP_ID=
#   META_APP_SECRET=

# Versión de la Marketing API -- configurable para no quedar pegado a un
# endpoint fijo cuando Meta retire versiones (default en código: v25.0).
META_MARKETING_API_VERSION=

# OBLIGATORIA -- sin valor por defecto. Debe ser exactamente "mock" o "live".
# "mock" activa el adaptador simulado (sin llamadas reales a Meta, sin
# gasto). Si falta o tiene otro valor, las funciones social-ads-* truenan con
# un error claro antes de intentar cualquier llamada a Meta.
META_ADS_MODE=

# Piso propio de presupuesto diario en MXN como salvaguarda de seguridad
# (no es el mínimo real de Meta, que varía y debe confirmarse contra la
# cuenta/documentación vigente antes de producción). Default en código: 50.
META_ADS_MIN_DAILY_BUDGET_MXN=
