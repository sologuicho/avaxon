      ]
    },
    "Agente IA": {
      "main": [
        [{ "node": "Procesar Output", "type": "main", "index": 0 }]
      ]
    },
    "GPT-4o": {
      "ai_languageModel": [
        [{ "node": "Agente IA", "type": "ai_languageModel", "index": 0 }]
      ]
    },
    "Memoria Conversacion": {
      "ai_memory": [
        [{ "node": "Agente IA", "type": "ai_memory", "index": 0 }]
      ]
    },
    "Procesar Output": {
      "main": [
        [{ "node": "Enviar WhatsApp", "type": "main", "index": 0 }]
      ]
    },
    "Enviar WhatsApp": {
      "main": [
        [{ "node": "¿Es Lead?", "type": "main", "index": 0 }]
      ]
    },
    "¿Es Lead?": {
      "main": [
        [{ "node": "Guardar Lead en Sheets", "type": "main", "index": 0 }],
        [{ "node": "Responder 200 a Meta", "type": "main", "index": 0 }]
      ]
    },
    "Guardar Lead en Sheets": {
      "main": [
        [{ "node": "Responder 200 a Meta", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
